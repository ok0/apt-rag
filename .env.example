# 산출물/색인 루트 디렉터리
APT_RAG_DATA_DIR=data
# 임베딩 모델 (Hugging Face repo id)
APT_RAG_EMBED_MODEL=BAAI/bge-m3
# 연산 장치: auto | mps | cpu
APT_RAG_DEVICE=auto
# 임베딩 배치 크기
APT_RAG_BATCH_SIZE=8
# 최대 시퀀스 길이(토큰)
APT_RAG_MAX_SEQ_LENGTH=1024
# OCR 엔진: none (이미지 기반 쪽이 있으면 설정 필요)
APT_RAG_OCR=none
# 벡터 코사인 유사도 컷오프 (0이면 끔). 벡터 후보가 하나도 통과하지 못하면 BM25 결과도 버립니다.
APT_RAG_MIN_VEC_SIM=0.55
# 동의어 사전 경로 (BM25 질의 확장용, 없으면 확장 안 함)
APT_RAG_SYNONYMS=synonyms.txt
# 컷오프 완화: 벡터 후보가 하나도 컷오프를 넘지 못할 때, (컷오프 - SIM_BAND) 이상이면서
# 벡터와 BM25 모두 상위 BAND_TOP_K 안에 든 조항이 있으면 통과 (SIM_BAND=0이면 끔)
APT_RAG_SIM_BAND=0.05
APT_RAG_BAND_TOP_K=20
# 평가 질문 생성(gen-questions)용 ollama 서버 주소와 모델
APT_RAG_OLLAMA_URL=http://localhost:11434
APT_RAG_LLM_MODEL=qwen2.5:7b
# Hugging Face 캐시 위치 (선택)
# HF_HOME=
# 모델 로드를 오프라인으로 강제 (첫 다운로드 이후 선택)
# HF_HUB_OFFLINE=1
